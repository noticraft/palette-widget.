<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Palette Widget</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --color-1: #E8EAF6;
      --color-2: #C5CAE9;
      --color-3: #9FA8DA;
      --color-4: #7986CB;
      --color-5: #5C6BC0;
    }

    /* Ocultar scrollbars para que se integre sin bordes raros en Notion */
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: transparent;
      user-select: none;
      -webkit-user-select: none;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", monospace;
    }

    .swatch {
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .swatch:hover {
      transform: translateY(-3px) scale(1.18);
    }

    .swatch:active {
      transform: translateY(0) scale(0.92);
    }

    /* Animación del feedback al copiar */
    .toast {
      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }

    .toast.show {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    .toast.hide {
      opacity: 0;
      transform: translateY(4px) scale(0.95);
    }
  </style>
</head>
<body class="flex flex-col items-center justify-center min-h-screen py-2 px-3">

  <!-- Contenedor flotante tipo Notion card minimalista -->
  <div class="relative flex flex-col items-center">
    
